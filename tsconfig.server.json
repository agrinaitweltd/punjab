{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "server-dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/lib/invoiceImport.ts", "src/lib/importMatching.ts", "src/lib/statementImport.ts", "src/lib/adminAccess.ts", "src/types/index.ts"]
}
